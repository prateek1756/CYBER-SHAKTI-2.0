# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=cybershakti

# --- Flask Microservice ---
FLASK_PORT=5001
FLASK_HOST=127.0.0.1

# --- Optional Tuning ---
# FLASK_HEALTH_TIMEOUT=10000
# FLASK_HEALTH_INTERVAL=500
# FLASK_HEALTH_MAX_RETRIES=20
# FLASK_SHUTDOWN_TIMEOUT=5000
