# Build & Run stage for CyberShakti Node/Express Server
FROM node:22-alpine AS base
WORKDIR /app

# Enable pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy root config and source files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server ./server
COPY client ./client
COPY tsconfig.json ./

# Install dependencies across all workspace packages
RUN pnpm install --ignore-scripts

# Build TypeScript server and Vite client
RUN pnpm --filter client build && pnpm --filter server build

EXPOSE 8080

ENV PORT=8080
ENV NODE_ENV=production
ENV FLASK_HOST=flask-server
ENV FLASK_PORT=5001

CMD ["pnpm", "--filter", "server", "start"]

